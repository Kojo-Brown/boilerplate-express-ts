# ── App ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── JWT (generate with: openssl rand -hex 32) ─────────────────────────────────
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32-output
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-32-output
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-openssl-rand-hex-32-output

# ── Magic link ────────────────────────────────────────────────────────────────
# How long an issued magic link stays redeemable, in seconds. The link is a
# bearer credential sitting in an inbox, so keep this short.
MAGIC_LINK_TTL_SECONDS=900

# ── Idempotency ───────────────────────────────────────────────────────────────
# How long a recorded response stays replayable for an `Idempotency-Key`, in
# seconds. This is the window in which a client's retry is absorbed instead of
# executed a second time.
IDEMPOTENCY_RETENTION_SECONDS=86400
# How long an unfinished request holds its key before a retry may take it over,
# in seconds. Keep it comfortably above the slowest guarded route: set below it,
# a request that is merely slow gets taken over and its work runs twice.
IDEMPOTENCY_LEASE_SECONDS=60
# How often each replica reaches for the purge lock, in seconds. Exactly one
# replica sweeps per tick — the others take a Postgres advisory lock, lose, and
# return — so this is the interval for the service as a whole and does not need
# lowering as replicas are added. Set to 0 to disable the in-process job and run
# the sweep from an external scheduler instead.
IDEMPOTENCY_PURGE_INTERVAL_SECONDS=3600

# ── Transactional outbox ──────────────────────────────────────────────────────
# How often each replica polls outbox_messages, in seconds. This is the delivery
# latency of every event published through the outbox. Every replica relays —
# claims are taken with SKIP LOCKED, so they work on disjoint rows rather than
# taking turns — which means adding a replica adds drain capacity. Set to 0 to
# disable the in-process relay and run it as its own process instead.
OUTBOX_RELAY_INTERVAL_SECONDS=5
# Messages claimed per transaction. Keep it small: the claim transaction stays
# open for the whole batch, holding a pooled connection and the cluster's xmin
# horizon, and the worst case is batch size × dispatch timeout.
OUTBOX_RELAY_BATCH_SIZE=20
# Deliveries attempted before a message is dead-lettered (status = 'dead' and
# never claimed again), counting the first.
OUTBOX_RELAY_MAX_ATTEMPTS=8
# Backstop for a dispatcher that never returns, in milliseconds. It bounds how
# long the relay waits, not the work — the dispatch may still succeed after it
# fires, which is one of the ways delivery is at-least-once.
OUTBOX_DISPATCH_TIMEOUT_MS=5000

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=boilerplate
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5432/boilerplate

# ── OAuth (Google) ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/oauth/google/callback

# ── Storage ───────────────────────────────────────────────────────────────────
# Which adapter the upload routes resolve out of the storage registry.
#   s3     — presign + upload to the bucket below (production)
#   memory — in-process store; no AWS credentials needed (local dev, tests)
STORAGE_DRIVER=s3

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET=your-s3-bucket-name
S3_PRESIGNED_EXPIRES_IN=3600

# ── CPU worker pool ───────────────────────────────────────────────────────────
# Threads available for CPU-bound work (currently: upload checksums).
# 0 = one per available core, minus one left for the event loop. The default,
# because the right number is a property of the machine rather than of the
# deployment. Set a value to pin it.
WORKER_POOL_SIZE=0
# Tasks that may wait for a thread before the pool answers 503 + Retry-After.
# A latency budget, not a memory one: with N threads and a task taking T, the
# last task in a full queue waits about (depth / N) * T.
WORKER_POOL_MAX_QUEUE_DEPTH=64
# Backstop for a task that will not finish. Enforcing it costs a thread —
# synchronous work cannot be interrupted, so the pool destroys and respawns —
# so keep it well above any legitimate task rather than using it as a deadline.
WORKER_POOL_TASK_TIMEOUT_MS=30000
WORKER_POOL_RETRY_AFTER_SECONDS=1
# Payloads at or above this size are hashed on a thread; smaller ones inline,
# because below roughly this size the message round trip costs more than the
# hashing it avoids.
WORKER_POOL_OFFLOAD_MIN_BYTES=65536

# --- CSV ingest (POST /v1/users/import) -------------------------------------
# The ceiling on an import body, enforced against the bytes that actually
# arrive. A chunked request declares no Content-Length, so the header is only a
# fast path and this is the real limit — and a route that reads the raw stream
# has no bound at all otherwise, since no body parser claimed it. 32 MiB is
# roughly 400,000 rows of `email,roles`; anything larger wants a job, not a
# request.
USER_IMPORT_MAX_BYTES=33554432
# How many rejected rows are described individually in the response. The counts
# stay exact; this bounds the detail, because the wrong file uploaded here
# rejects every row.
USER_IMPORT_MAX_REPORTED_ERRORS=100

# --- Server-Sent Events (GET /v1/events/stream) ------------------------------
# Comment interval on an idle stream. It has to sit comfortably below the
# shortest idle timeout on the path — nginx's proxy_read_timeout and an ALB's
# idle timeout are both 60s by default — because the budget is consumed by the
# gap between heartbeats and a tick can be late under load. It is also what
# bounds how long a connection whose peer vanished without a FIN keeps its slot.
SSE_HEARTBEAT_INTERVAL_MS=15000
# The reconnection delay advertised to clients. The only backoff control the
# server has over an EventSource, which reconnects on its own forever — so it is
# what a rolling restart's thundering herd gets spread over.
SSE_RETRY_MS=3000
# Events kept resumable for a reconnecting client. A count rather than a
# duration because what it bounds is memory, held for the life of the process
# whether or not anybody reconnects. A client that misses more than this is told
# to re-read state rather than handed a partial history.
SSE_REPLAY_BUFFER_SIZE=256
# Concurrent streams this process will hold open. Nothing else bounds them: an
# event stream has no request that ends.
SSE_MAX_CONNECTIONS=1000
# Bytes that may sit unacknowledged for one stream before it is dropped as a
# slow consumer. res.write() to a peer that has stopped reading buffers in this
# process without limit. Dropping is safe here in a way it is not elsewhere —
# the client reconnects with Last-Event-ID and is replayed what it missed.
SSE_MAX_BUFFERED_BYTES=1048576
# The Retry-After advertised when SSE_MAX_CONNECTIONS is reached.
SSE_RETRY_AFTER_SECONDS=5

# --- WebSockets (ws://…/v1/ws) -----------------------------------------------
# Whether the endpoint is attached at all. A deployment that does not want a
# WebSocket surface leaves it off rather than firewalling a path.
WS_ENABLED=true
WS_PATH=/v1/ws
# Concurrent sockets this process will hold. Nothing else bounds them: a
# WebSocket has no request that ends.
WS_MAX_CONNECTIONS=1000
# The largest frame ws will reassemble. This is the only real bound on inbound
# memory — an application-level size check runs after the whole frame has been
# buffered, so it can complain about a 500 MB message but not prevent one.
WS_MAX_PAYLOAD_BYTES=65536
# Inbound messages admitted in one burst, per connection. Real clients are
# bursty (a page that reconnects and re-subscribes to nine things sends nine
# frames in a millisecond), and a limiter with no burst allowance closes exactly
# the connections that were behaving.
WS_RATE_LIMIT_BURST=20
WS_RATE_LIMIT_MESSAGES_PER_SECOND=10
# A second dimension, because message count does not bound work: 10 messages a
# second of 64 KB each is inside any message budget and is 640 KB/s of parsing.
WS_RATE_LIMIT_BYTES_PER_SECOND=131072
# How often a quiet socket is pinged, and how long the peer has to answer. Must
# sit below the shortest idle timeout on the path (nginx's proxy_read_timeout
# and an ALB's idle timeout are both 60s by default). It is also what turns a
# peer that vanished without a FIN into a socket that eventually closes.
WS_HEARTBEAT_INTERVAL_MS=30000
# Outbound bytes that may sit unacknowledged for one socket before it is dropped
# as a slow consumer. send() to a peer that has stopped reading buffers in this
# process without limit.
WS_MAX_BUFFERED_BYTES=1048576
# Origins a browser may open a socket from, comma-separated, or * for any.
# A WebSocket handshake ignores the same-origin policy and CORS does not apply
# to it, so Origin is the only signal about which page initiated a browser
# connection. Defence in depth behind bearer auth — see docs/websockets.md.
# Left empty, CORS_ORIGIN is used.
WS_ALLOWED_ORIGINS=

# --- Redis Streams consumer (pnpm worker:stream) -----------------------------
# Where the consumer connects. Empty disables the whole subsystem: the worker
# process refuses to start and the outbox keeps delivering to the local bus, so
# Redis is an opt-in dependency rather than one every developer must run.
REDIS_URL=
# The stream domain events are published to and consumed from. One key rather
# than one per event type: a consumer group is per stream, so splitting by type
# would mean a group, a consumer and a reclaim loop for each, and a group gives
# no ordering guarantee to preserve anyway.
REDIS_STREAM_KEY=domain-events
# The consumer group every worker replica joins. A second, differently-named
# group over the same key is how a new consumer (an analytics sink, say) reads
# everything without taking entries away from this one.
REDIS_STREAM_GROUP=api-workers
# This replica's name inside the group. Empty means the hostname, which under an
# orchestrator is stable across container restarts — so a restarted worker
# rejoins as itself and finds its own unfinished entries. A name containing the
# pid would leave an orphan consumer behind on every restart.
REDIS_STREAM_CONSUMER=
# The stream's length cap, enforced by the producer with MAXLEN ~. Acknowledging
# an entry does NOT remove it from the stream, so without this the key grows for
# as long as the service runs. Size it as a safety margin over the worst
# tolerable backlog, not as a queue depth: an entry evicted while still pending
# is lost work.
REDIS_STREAM_MAX_LEN=100000
# Entries read per XREADGROUP. They are handled one at a time, so this is a
# round-trip optimisation and not a concurrency setting.
REDIS_STREAM_BATCH_SIZE=16
# How long a read blocks on an empty stream. Also the floor on how long a
# graceful shutdown takes, since the read is already in flight when SIGTERM
# arrives and cannot be cut short without abandoning work.
REDIS_STREAM_BLOCK_MS=2000
# Backstop for a handler that never returns. Like the outbox's, it bounds the
# worker's wait rather than the work.
REDIS_STREAM_HANDLER_TIMEOUT_MS=10000
# How long an entry must sit unacknowledged before another consumer may claim
# it — the recovery latency after a replica dies. MUST stay above
# REDIS_STREAM_HANDLER_TIMEOUT_MS (the config refuses otherwise): below it, an
# entry a healthy but slow consumer is still working on becomes claimable and
# the work runs twice, concurrently.
REDIS_STREAM_MIN_IDLE_MS=30000
# Deliveries before an entry is parked on <key>:parked and acknowledged,
# counting the first. Finite because claim-on-stall has no other stopping
# condition: an entry that kills its handler is idle again a moment later,
# forever.
REDIS_STREAM_MAX_DELIVERIES=5
# How often the pending list is scanned for stalled entries. Keep it well below
# REDIS_STREAM_MIN_IDLE_MS — worst-case recovery is the sum of the two.
REDIS_STREAM_RECLAIM_INTERVAL_MS=5000
# Where the outbox relay delivers a claimed row.
#   bus          — publish on the claiming API replica's in-process bus (default)
#   redis-stream — append to REDIS_STREAM_KEY and let the consumer group decide
#                  who runs it, moving subscriber work off the API replicas.
#                  Requires REDIS_URL and a running `pnpm worker:stream`.
OUTBOX_DISPATCH_TARGET=bus

# --- Graceful shutdown -------------------------------------------------------
# How long the process keeps serving normally after SIGTERM before closing its
# listener. This is the window a load balancer has to notice /v1/health has gone
# 503 and stop routing here; closing the listener sooner means ECONNREFUSED for
# requests it routed in good faith. Set it above the readiness probe's period
# times its failure threshold. 0 for a deployment nothing is polling, and for
# local development where it is only a slower Ctrl-C (a second Ctrl-C exits now).
SHUTDOWN_DRAIN_DELAY_MS=5000
# The whole sequence's budget, the drain delay included. Must be below the
# orchestrator's grace period (Kubernetes: terminationGracePeriodSeconds, 30s by
# default) — that clock ends in SIGKILL, and the difference is the margin this
# process needs to log what it closed and exit on its own terms.
SHUTDOWN_TIMEOUT_MS=25000

# ── Job queue (BullMQ) ────────────────────────────────────────────────────────
# Uses REDIS_URL above. With it empty the queue is never constructed and
# `pnpm worker:queue` refuses to start, which is what keeps Redis an opt-in
# dependency rather than one every developer has to run to boot the API.
# The queue background work is produced onto and consumed from. One queue rather
# than one per job name: a worker consumes a single queue, so splitting by name
# means a process, a connection and a concurrency budget for each. Split when
# two kinds of work genuinely need different ones — a slow export starving quick
# notifications is the usual reason — not before.
JOB_QUEUE_NAME=jobs
# Namespaces every Redis key the queue owns. BullMQ's own default, restated here
# because a deployment that changes it must change it for the producer and the
# worker together or the two address different keys.
JOB_QUEUE_PREFIX=bull
# Runs of a job before it is dead-lettered, counting the first. With the base
# and ceiling below, five attempts spans roughly a minute of outage.
JOB_QUEUE_ATTEMPTS=5
# Ceiling on the first retry's delay; the window doubles per attempt and the
# actual delay is drawn uniformly from it (full jitter).
JOB_QUEUE_BASE_DELAY_MS=500
# Ceiling on any single delay, however many attempts have passed. MUST be at
# least JOB_QUEUE_BASE_DELAY_MS (the config refuses otherwise): below it, every
# retry draws from the same window and the ladder never widens.
JOB_QUEUE_MAX_DELAY_MS=30000
# Jobs one worker process runs at once. They share an event loop, so this buys
# overlap on I/O and nothing on CPU — and it multiplies how many jobs a SIGKILL
# leaves for another worker to reclaim.
JOB_QUEUE_CONCURRENCY=4
# How long a job's lock survives before another worker may treat it as stalled.
# Renewed every half of this while a handler runs, so it bounds recovery after a
# crash rather than the handler. Set below the slowest healthy handler it
# classifies a slow job as a dead one and runs the work twice, concurrently.
JOB_QUEUE_LOCK_DURATION_MS=30000
# Completed jobs kept, for debugging. A count rather than an age because what it
# bounds is Redis memory.
JOB_QUEUE_KEEP_COMPLETED=1000
# Failed jobs kept. This is the dead-letter queue's backstop — the transfer
# reads the job out of the failed set — so it may not be zero and the producer
# refuses to start if it is.
JOB_QUEUE_KEEP_FAILED=5000
# Dead-letter records kept on <JOB_QUEUE_NAME>-dead-letter before the oldest are
# dropped. Much smaller than the failed retention: records arrive at the rate
# things go wrong rather than at the rate things happen.
JOB_DEAD_LETTER_MAX_SIZE=10000

# --- Outbound HTTP (bulkhead + circuit breaker + retry + timeouts) ---------
# Defaults for every client built by `createDependencyClient`. A client may
# override any of them per dependency; these are what an operator can change
# during an incident without a deploy.

# Deadline for one attempt, covering headers and body. Without it the failure a
# breaker most needs to see — a dependency that accepts connections and never
# answers — never completes, so nothing is recorded and the socket is held.
HTTP_CLIENT_TIMEOUT_MS=5000
# Deadline for response headers alone, cleared the instant they arrive. Because
# it covers no body it can be set to what a healthy answer really costs, so a
# wedged upstream is written off in a fraction of the budget above. Must be at
# most HTTP_CLIENT_TIMEOUT_MS, or the coarse deadline always fires first and
# this one silently never runs.
HTTP_CLIENT_HEADERS_TIMEOUT_MS=2000
# Longest gap between response body chunks before the exchange is failed and the
# socket released. Independent of body size, which is why it stays meaningful
# after HTTP_CLIENT_TIMEOUT_MS has been raised for a large download. Same
# ceiling as above, for the same reason.
HTTP_CLIENT_BODY_IDLE_TIMEOUT_MS=2000
# Calls allowed in flight to one dependency at once, and how many may queue for
# a slot. This is the cap a circuit breaker cannot provide: a dependency that
# slows from 20ms to 5s never *fails*, so the breaker stays closed — correctly —
# while calls to it pile up and hold every request handler in the process.
HTTP_CLIENT_BULKHEAD_MAX_CONCURRENT=32
# Two rounds of the cap: enough to absorb ordinary bursts, small enough that a
# saturated dependency sheds load instead of growing a backlog. 0 disables the
# queue entirely, making the bulkhead pure load-shedding.
HTTP_CLIENT_BULKHEAD_MAX_QUEUE=64
# Longest a queued caller waits before being refused with a 503. A bounded queue
# with no deadline is still unbounded in time, and eventually admits work whose
# requester left seconds ago.
HTTP_CLIENT_BULKHEAD_QUEUE_TIMEOUT_MS=1000
# Attempts per call, counting the first. Each extra attempt is another multiple
# of the load a struggling dependency receives at its worst moment.
HTTP_CLIENT_RETRY_ATTEMPTS=3
# Ceiling on the first retry's window; it doubles per attempt and the delay is
# drawn uniformly from it (full jitter — see src/lib/backoff.ts).
HTTP_CLIENT_RETRY_BASE_DELAY_MS=100
# Ceiling on any single retry window. Must be at least the base delay, or every
# attempt draws from the same window and the ladder never widens.
HTTP_CLIENT_RETRY_MAX_DELAY_MS=2000
# Longest `Retry-After` an origin can talk this client into waiting out. Above
# it the response is returned unretried, so the caller can degrade now.
HTTP_CLIENT_MAX_RETRY_AFTER_MS=20000
# How much of a retried response body is read so the connection can be reused
# instead of re-handshaked. Never applies to a body the caller receives.
HTTP_CLIENT_DRAIN_BYTES=65536
# How much history a breaker counts, and at what resolution it forgets it.
HTTP_CLIENT_BREAKER_WINDOW_MS=10000
HTTP_CLIENT_BREAKER_BUCKETS=10
# Failure fraction at which a breaker opens, in (0, 1].
HTTP_CLIENT_BREAKER_FAILURE_RATE=0.5
# Outcomes required in the window before that rate may trip anything. Must be at
# least HTTP_CLIENT_RETRY_ATTEMPTS: retries are counted individually, so a lower
# value lets one call's own ladder fill the window and open the circuit alone.
HTTP_CLIENT_BREAKER_MIN_THROUGHPUT=20
# How long a breaker stays open before admitting a probe. The probe instant is
# jittered, so replicas that tripped together do not return together.
HTTP_CLIENT_BREAKER_OPEN_MS=30000
# Concurrent probes while half-open, and consecutive probe successes needed to
# close. One and one: the question is "is it back", and asking it ten times at
# once is the herd the breaker exists to prevent.
HTTP_CLIENT_BREAKER_HALF_OPEN_PROBES=1
HTTP_CLIENT_BREAKER_HALF_OPEN_SUCCESSES=1
